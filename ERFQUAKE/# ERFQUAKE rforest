package_packages <- c('tidyverse', 'mlr3', 'glmnet', 'caret', 'data.table', 'ggplot2', 'rsample','recipes')
#install.packages(package_packages)
library(tidyverse)
library(glmnet)
library(mlr3)
library(caret)
library(data.table)
library(ggplot2)
library(rsample)
library(recipes)
library(gbm)
library(h2o)
library(xgboost)
library(data.table)

set.seed(2)

erf <- fread('C:/Users/Johanner/R projects/ERFQUAKE/earthquakes.csv')

# prep
sauberf <- erf %>% select(
  magnitude,
  felt,
  cdi,
  mmi,
  tsunami,
  sig,
  nst,
  dmin,
  rms,
  depth,
  latitude
)

#sauberf$alert[is.nan(sauberf$alert)] <- 0

sauberf$cdi <- as.factor(sauberf$cdi)
sauberf$mmi <- as.factor(sauberf$mmi)
#sauberf$alert <- as.factor(sauberf$alert)
sauberf$tsunami <- as.factor(sauberf$tsunami)

# aufsetzen von trainings und testsplit 70/30
index_sauberf_gbm <- sample(2, nrow(sauberf), replace = TRUE, prob = c(0.7, 0.3))
sauberf_train_gbm <- sauberf[index_sauberf_gbm == 1, ]
sauberf_test_gbm <- sauberf[index_sauberf_gbm == 2, ]

# model
sauberf_gbm <- gbm(
  formula = sig ~ .,
  data = sauberf_train_gbm,
  distribution = "gaussian",
  n.trees = 10000,
  shrinkage = 0.01,
  interaction.depth = 10,
  n.minobsinnode = 15,
  cv.folds = 20
)

# find index for number trees with minimum CV error
best <- which.min(sauberf_gbm$cv.error)

# get MSE and compute RMSE
sqrt(sauberf_gbm$cv.error[best])

# plot error curve
gbm.perf(sauberf_gbm, method = "cv")

# plotten
plot(varImp(sauberf_gbm,scale=TRUE))
ggplot(sauberf_gbm)

# predictions 
sauberf_predictions_gbm <- predict(sauberf_gbm, newdata = sauberf_test_gbm)

# mean squared error zwischen predicted und real
sauberf_mse_gbm <- mean((sauberf_test_gbm$sig - sauberf_predictions_gbm)^2)