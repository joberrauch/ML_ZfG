package_packages <- c('tidyverse', 'mlr3', 'glmnet', 'caret', 'data.table', 'ggplot2', 'rsample','recipes')
#install.packages(package_packages)
library(tidyverse)
library(glmnet)
library(mlr3)
library(caret)
library(data.table)
library(ggplot2)
library(rsample)
library(recipes)

set.seed(2)

erf <- fread('C:/Users/Johanner/R projects/ERFQUAKE/earthquakes.csv')

# prep
sauberf <- erf %>% select(
  magnitude,
  felt,
  cdi,
  mmi,
  tsunami,
  sig,
  nst,
  dmin,
  rms,
  depth,
  latitude
)

#sauberf$alert[is.nan(sauberf$alert)] <- 0

sauberf$cdi <- as.factor(sauberf$cdi)
sauberf$mmi <- as.factor(sauberf$mmi)
#sauberf$alert <- as.factor(sauberf$alert)
sauberf$tsunami <- as.factor(sauberf$tsunami)

# aufsetzen von trainings und testsplit 70/30
index_sauberf_en <- sample(2, nrow(sauberf), replace = TRUE, prob = c(0.7, 0.3))
sauberf_train_en <- sauberf[index_sauberf_en == 1, ]
sauberf_test_en <- sauberf[index_sauberf_en == 2, ]

# control parameter
sauberf_control_en <- trainControl(method = 'repeatedcv', number = 10, repeats = 5, verboseIter = TRUE)

# model fitting
sauberf_elnet <- train(sig~., sauberf_train_en,  method = 'glmnet', tuneGrid = expand.grid(alpha = seq(0,1,length = 10), lambda = seq(0.0001, 0.2, length = 5)), 
trControl = sauberf_control_en)

# plotten
plot(varImp(sauberf_elnet,scale=TRUE))
ggplot(sauberf_elnet)

# predictions 
sauberf_predictions_en <- predict(sauberf_elnet, newdata = sauberf_test_en)

# mean squared error zwischen predicted und real
sauberf_mse_en <- mean((sauberf_test_en$sig - sauberf_predictions_en)^2)

# mean squared error zwischen mean und real
meanmean1 <- mean(sauberf_train_en$sig)
sauberf_mse_stupid1 <- mean((sauberf_test_en$sig - meanmean1)^2)
sqrtstupid1 <- sqrt(sauberf_mse_stupid1)
